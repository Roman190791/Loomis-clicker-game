import asyncio
import aiohttp
from aiogram import Bot, Dispatcher, types, Router, F

API_TOKEN = "ТУТ_ВСТАВ_ТОКЕН"

bot = Bot(token=API_TOKEN)
dp = Dispatcher()
router = Router()

BACKEND_URL = "https://loomis-clicker-game-1.onrender.com/api/user"


@router.message(commands=["start"])
async def cmd_start(message: types.Message):
    user_id = message.from_user.id
    username = message.from_user.username or message.from_user.first_name

    # Відправляємо дані на бекенд
    async with aiohttp.ClientSession() as session:
        async with session.post(BACKEND_URL, json={"id": user_id, "username": username}) as resp:
            if resp.status == 200:
                await message.answer(f"Привіт, {username}! Твої дані збережено ✅")
            else:
                await message.answer("⚠️ Виникла помилка при збереженні даних.")


# Тестовий хендлер — щоб перевірити, що бот працює
@router.message(F.text)
async def echo(message: types.Message):
    await message.answer("Я працюю ✅")


async def main():
    dp.include_router(router)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
